#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ENV_FILE="${PRINT_HELPER_ENV:-$ROOT/configs/print_factory.env}"

if [[ -r "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

export PRINT_HELPER_ROOT="$ROOT"
exec "${PRINT_HELPER_PYTHON:-python3}" "$ROOT/scripts/print3d/print_helper.py" "$@"

