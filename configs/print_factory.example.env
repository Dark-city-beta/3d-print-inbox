# Local 3D print factory defaults. Copy to configs/print_factory.env and edit.
PRINT_INBOX=/path/to/3d-print-inbox
PRINT_JOBS=/path/to/3d-print-jobs
PRINT_MOONRAKER_URL=http://YOUR_PRINTER_IP:7125
PRINT_DEFAULT_PRINTER=flyingbear_s1
PRINT_DEFAULT_MODE=beautiful-strong
PRINT_DEFAULT_FILAMENT=PETG
PRINT_DEFAULT_CALIBRATION=auto
PRINT_DEFAULT_NOZZLE_CHECK=manual
PRINT_DEFAULT_PRESENT_Z=235
